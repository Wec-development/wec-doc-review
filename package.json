{
  "name": "doc-review",
  "version": "0.1.0",
  "private": true,
  "description": "Ingest PDFs, extract values with an LLM, and review every value against its source evidence.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @doc-review/shared build && pnpm --parallel --filter \"./apps/*\" run \"/^(dev|worker:dev)$/\"",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r test",
    "test:unit": "pnpm -r test:unit",
    "test:integration": "pnpm --filter @doc-review/api test:integration",
    "test:e2e": "pnpm --filter @doc-review/api test:e2e",
    "test:coverage": "pnpm -r test:coverage",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @doc-review/shared build && pnpm --filter @doc-review/api db:migrate",
    "db:seed": "pnpm --filter @doc-review/shared build && pnpm --filter @doc-review/api db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
