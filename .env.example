# Copy to .env and fill in. Never commit .env.

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://app:app@localhost:5433/app

# API
API_PORT=3000
# Uploaded PDFs (relative to the API's working directory, i.e. apps/api/storage in dev)
STORAGE_DIR=./storage
# Origin of the review UI, allowed by CORS
WEB_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=10

# Worker (job queue)
WORKER_POLL_INTERVAL_MS=1000
WORKER_CONCURRENCY=2
WORKER_SHUTDOWN_TIMEOUT_MS=10000
JOB_LEASE_SECONDS=120
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_BASE_MS=2000
# llm = real extraction (PDF text + LLM), the default: the provider, model and API key are set
# in the app (Settings) and stored encrypted in Postgres; until then documents stay queued.
# fake = deterministic values without any LLM call (demos only).
EXTRACTOR=
# Fake extractor only: succeed | retryable | permanent, and simulated duration
FAKE_EXTRACTOR_BEHAVIOR=succeed
FAKE_EXTRACTOR_DELAY_MS=1500

# Encryption of the stored LLM API key (AES-256-GCM). The encryption key never goes in the
# database. Either set APP_ENCRYPTION_KEY (32 bytes, base64: `openssl rand -base64 32`), or leave
# it empty and a key file is generated in SECRETS_DIR on first start (mode 0600, git-ignored).
# Changing or losing this key makes the saved API key unreadable: enter it again in Settings.
APP_ENCRYPTION_KEY=
SECRETS_DIR=./secrets

# One model call may take this long before it counts as a retryable timeout
LLM_TIMEOUT_MS=120000
# Documents whose parsed text is longer fail permanently (no oversized prompts)
MAX_DOCUMENT_CHARS=100000

# Web app → API base URL. Leave empty to use same-origin /api, which the Vite dev server (pnpm dev)
# and nginx (Docker) both proxy to the API. Set it only to point the web app at another API.
VITE_API_URL=
