# Copy to .env and fill in. Never commit .env.

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://app:app@localhost:5433/app

# API
API_PORT=3000
# Uploaded PDFs (relative to the API's working directory, i.e. apps/api/storage in dev)
STORAGE_DIR=./storage
# Origin of the review UI, allowed by CORS
WEB_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=10

# LLM provider key (Anthropic or OpenAI)
LLM_API_KEY=
LLM_MODEL=

# Web app → API base URL
VITE_API_URL=http://localhost:3000
