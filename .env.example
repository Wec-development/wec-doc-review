# Copy to .env and fill in. Never commit .env.

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://app:app@localhost:5433/app

# API
API_PORT=3000
# Uploaded PDFs (relative to the API's working directory, i.e. apps/api/storage in dev)
STORAGE_DIR=./storage
# Origin of the review UI, allowed by CORS
WEB_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=10

# Worker (job queue)
WORKER_POLL_INTERVAL_MS=1000
WORKER_CONCURRENCY=2
WORKER_SHUTDOWN_TIMEOUT_MS=10000
JOB_LEASE_SECONDS=120
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_BASE_MS=2000
# llm = real extraction (PDF text + LLM); fake = deterministic values, no LLM call.
# Leave empty to use llm when LLM_API_KEY is set and fake otherwise (tests and CI have no key).
EXTRACTOR=
# Fake extractor only: succeed | retryable | permanent, and simulated duration
FAKE_EXTRACTOR_BEHAVIOR=succeed
FAKE_EXTRACTOR_DELAY_MS=1500

# LLM (Anthropic or OpenAI). The key is a secret: never commit it; it is never logged or stored.
# The key, the model and the provider must all belong to the same provider.
LLM_API_KEY=
# Required when EXTRACTOR=llm, e.g. claude-opus-5-5 (Anthropic) or gpt-4o-mini (OpenAI)
LLM_MODEL=claude-opus-5-5
# anthropic | openai. Leave empty to infer it from LLM_MODEL (claude-* → anthropic;
# gpt-*, o1/o3/o4…, chatgpt-* → openai). Set it for any other model name.
LLM_PROVIDER=
# One model call may take this long before it counts as a retryable timeout
LLM_TIMEOUT_MS=120000
# Documents whose parsed text is longer fail permanently (no oversized prompts)
MAX_DOCUMENT_CHARS=100000

# Web app → API base URL
VITE_API_URL=http://localhost:3000
