# Copy to .env and fill in. Never commit .env.

# Postgres (matches docker-compose.yml)
DATABASE_URL=postgres://app:app@localhost:5433/app

# API
API_PORT=3000
# Uploaded PDFs (relative to the API's working directory, i.e. apps/api/storage in dev)
STORAGE_DIR=./storage
# Origin of the review UI, allowed by CORS
WEB_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=10

# Worker (job queue)
WORKER_POLL_INTERVAL_MS=1000
WORKER_CONCURRENCY=2
WORKER_SHUTDOWN_TIMEOUT_MS=10000
JOB_LEASE_SECONDS=120
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_BASE_MS=2000
# fake = deterministic values, no LLM call (until Step 6 adds `llm`)
EXTRACTOR=fake
# Fake extractor only: succeed | retryable | permanent, and simulated duration
FAKE_EXTRACTOR_BEHAVIOR=succeed
FAKE_EXTRACTOR_DELAY_MS=1500

# LLM provider key (Anthropic or OpenAI)
LLM_API_KEY=
LLM_MODEL=

# Web app → API base URL
VITE_API_URL=http://localhost:3000
