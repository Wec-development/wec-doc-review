{
  "name": "@doc-review/api",
  "version": "0.1.0",
  "private": true,
  "description": "HTTP API and extraction worker. Postgres is the system of record.",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "worker:dev": "tsx watch --env-file-if-exists=../../.env src/worker/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "worker": "node dist/worker/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "vitest run --project e2e",
    "test:coverage": "vitest run --coverage",
    "test:live": "LLM_LIVE_TEST=1 vitest run --config vitest.live.config.ts",
    "llm:models": "tsx src/llm/print-models.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/run-seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@doc-review/shared": "workspace:*",
    "@fastify/cors": "^11.4.3",
    "@fastify/multipart": "^10.1.8",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "openai": "7.47.0",
    "pdfjs-dist": "^6.5.438",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
