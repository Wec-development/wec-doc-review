{
  "name": "@doc-review/shared",
  "version": "0.1.0",
  "private": true,
  "description": "Types, field definitions and validation schemas shared by the API and the web app.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.1.0",
    "typescript": "^5.9.3",
    "vitest": "^5.1.0"
  }
}
