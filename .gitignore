# Dependencies
node_modules/

# Build output
dist/
build/
coverage/
*.tsbuildinfo

# Environment — never commit real secrets; use .env.example
.env
.env.*
!.env.example

# The key that encrypts stored LLM API keys (SECRETS_DIR). Never commit it. Anchored so a
# source folder named secrets/ would not be ignored by accident.
/secrets/
/apps/api/secrets/

# Uploaded PDFs stored at runtime (STORAGE_DIR). Anchored so source folders such as
# apps/api/src/storage/ are not ignored.
/storage/
/apps/api/storage/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# OS / editor
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Personal AI working notes (not part of the product)
CLAUDE.local.md
docs-private/
